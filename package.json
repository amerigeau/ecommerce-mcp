{
  "name": "ecommerce-mcp",
  "version": "0.1.0",
  "description": "MCP server to read and safely update PrestaShop and WooCommerce stores",
  "type": "module",
  "license": "MIT",
  "author": "Arnaud Merigeau (https://arnaud-merigeau.fr)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amerigeau/ecommerce-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ecommerce-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "msw": "^2.8.0",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.0"
  }
}
